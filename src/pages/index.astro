---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/site/Hero.astro';
import MissionStatement from '../components/site/MissionStatement.astro';
import FeaturedStories from '../components/site/FeaturedStories.astro';
import LatestArticles from '../components/site/LatestArticles.astro';
import CategoryExplorer from '../components/site/CategoryExplorer.astro';
import MultimediaSection from '../components/site/MultimediaSection.astro';
import FounderIntro from '../components/site/FounderIntro.astro';
import { siteConfig } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  founder: {
    '@type': 'Person',
    name: siteConfig.editor.name,
  },
};
---

<BaseLayout jsonLd={jsonLd}>
  <Hero />
  <MissionStatement />
  <FeaturedStories />
  <LatestArticles />
  <CategoryExplorer />
  <MultimediaSection />
  <FounderIntro />
</BaseLayout>
