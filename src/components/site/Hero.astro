---
// The official photograph (public/images/hero.jpeg, 700 x 1244) is shown whole and
// proportionally on every screen size. It is never stretched, cropped or edited;
// all fades and lighting are CSS overlays.
// alt="" because the image is decorative here: the headline and text carry the meaning.
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <div class="hero-photo">
      <img
        class="hero-img"
        src="/images/hero.jpeg"
        alt=""
        width="700"
        height="1244"
        fetchpriority="high"
        decoding="sync"
      />
    </div>
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="kicker rise" style="--d: 0ms">Independent science &amp; health journalism</p>
      <h1 id="hero-title" class="rise" style="--d: 120ms">
        Science, made clear. <span class="h1-sub">From Kenya to the world.</span>
      </h1>
      <p class="lede rise" style="--d: 240ms">
        Arnold's Science Desk turns research, health information and technology into reporting that
        ordinary readers can understand and use, grounded in Kenya and Africa, and alert to the world.
      </p>
      <div class="actions rise" style="--d: 360ms">
        <a class="btn btn-primary" href="#latest">Read the latest</a>
        <a class="btn btn-ghost" href="#topics">Explore topics</a>
      </div>
      <p class="coverage rise" style="--d: 480ms">
        <span>Coverage</span> Kenya <i aria-hidden="true">·</i> Africa <i aria-hidden="true">·</i> Global
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    --photo-w: min(100vw, 30rem);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--black);
  }

  /* ---------- Background photograph (mobile first) ---------- */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Restrained crimson lighting, above the photograph */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(55% 40% at 78% 14%, rgba(184, 29, 42, 0.14), transparent 70%);
  }

  /* Mobile: the whole portrait across the top, centred */
  .hero-photo {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: var(--photo-w);
    margin-inline: auto;
    overflow: hidden;
  }
  .hero-img {
    width: 100%;
    height: auto;
    animation: reveal 1.8s var(--ease) both;
  }

  /* Fades: darker towards the lower part (where the text sits) and softly at the sides */
  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(5, 7, 11, 0.35) 0%,
        rgba(5, 7, 11, 0) 18%,
        rgba(5, 7, 11, 0.55) 48%,
        rgba(5, 7, 11, 0.92) 74%,
        var(--black) 100%
      ),
      linear-gradient(90deg, var(--black) 0%, transparent 12%, transparent 88%, var(--black) 100%);
  }

  /* ---------- Text ---------- */
  .hero-inner {
    position: relative;
    padding-top: calc(var(--photo-w) * 0.78);
    padding-bottom: 3rem;
  }

  .hero-copy {
    max-width: 40rem;
    font-family: var(--font-sans);
  }

  h1 {
    margin-top: 1.1rem;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 500;
    font-style: normal;
    font-optical-sizing: auto;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.55);
  }

  .h1-sub {
    display: block;
    margin-top: 0.3em;
    font-family: var(--font-serif);
    font-size: 0.78em;
    font-weight: 400;
    font-style: normal;
    letter-spacing: -0.01em;
    color: var(--silver);
  }

  .lede {
    max-width: 34rem;
    margin-top: 1.4rem;
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    font-weight: 400;
    line-height: 1.6;
    color: var(--silver);
    text-shadow: 0 1px 20px rgba(0, 0, 0, 0.6);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .actions .btn-ghost { background: rgba(5, 7, 11, 0.45); }
  .actions .btn-ghost:hover { background: rgba(5, 7, 11, 0.7); }

  .coverage {
    margin-top: 2.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--silver);
  }
  .coverage span { margin-right: 0.8rem; color: var(--muted); }
  .coverage i { margin-inline: 0.35rem; color: var(--crimson-bright); font-style: normal; }

  /* ---------- Desktop: complete photograph on the right, text on the left ---------- */
  @media (min-width: 860px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: clamp(34rem, 80svh, 46rem);
    }

    /*
      Explicit box: exactly the hero's height, width derived from the photograph's own
      700:1244 ratio, right edge on the content container's right edge.
    */
    .hero-photo {
      top: 0;
      bottom: auto;
      left: auto;
      right: max(var(--gutter), calc((100% - var(--max)) / 2));
      width: auto;
      height: 100%;
      aspect-ratio: 700 / 1244;
      margin: 0;
    }
    .hero-img {
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: contain;
      object-position: center;
    }

    /* Fade into black: strongly on the text side, gently on the other edges */
    .hero-photo::after {
      background:
        linear-gradient(90deg, var(--black) 0%, rgba(5, 7, 11, 0.7) 18%, transparent 55%),
        linear-gradient(270deg, var(--black) 0%, transparent 12%),
        linear-gradient(180deg, var(--black) 0%, transparent 10%, transparent 88%, var(--black) 100%);
    }
    .hero-media::after {
      background: radial-gradient(40% 60% at 84% 40%, rgba(184, 29, 42, 0.16), transparent 70%);
    }

    .hero-inner {
      padding-block: 4rem;
    }
    .hero-copy { max-width: min(40rem, 60%); }

    h1 { font-size: clamp(2.6rem, 5.4vw, 4.5rem); }
  }

  /* Narrow desktops and landscape tablets: keep the text clear of the photograph */
  @media (min-width: 860px) and (max-width: 1100px) {
    .hero-copy { max-width: 52%; }
    .hero-photo::after {
      background:
        linear-gradient(90deg, var(--black) 0%, rgba(5, 7, 11, 0.85) 30%, transparent 75%),
        linear-gradient(270deg, var(--black) 0%, transparent 12%),
        linear-gradient(180deg, var(--black) 0%, transparent 10%, transparent 88%, var(--black) 100%);
    }
  }

  @keyframes reveal {
    from { opacity: 0; transform: scale(1.04); }
    to { opacity: 1; transform: none; }
  }
</style>
